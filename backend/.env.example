# Copia este archivo a ".env". NUNCA lo subas a GitHub.

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Base de datos PostgreSQL (Neon, Supabase, Render...). 
# DÉJALO VACÍO en desarrollo: Tako usa una base local embebida (carpeta .data) y no necesitas instalar nada.
DATABASE_URL=

PORT=5000
# URL(s) del frontend permitidas por CORS, separadas por coma
CLIENT_URL=http://localhost:5173
